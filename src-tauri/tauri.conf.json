{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KickCut",
  "version": "0.2.0",
  "identifier": "com.unsatisfied0.kickcut",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5184",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KickCut",
        "width": 1240,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "theme": "Dark",
        "backgroundColor": "#0c110f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.kick.com https://files.kick.com; connect-src ipc: http://ipc.localhost https://kick.com https://stream.kick.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "unsatisfied0",
    "copyright": "unsatisfied0",
    "shortDescription": "Download and trim Kick VODs",
    "longDescription": "Browse a Kick channel's past broadcasts, pick a quality and a time range, and download it as an MP4 that opens cleanly in an editor.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish",
          "German"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCRTU4RDY5RUREQTZEQTMKUldTamJkcnRhWTNsUzI3eWVoa25VbVBpVUhLUUp2aVlnZXRXVGxQeDBXM3dXT1Q5Risza0I3T1kK",
      "endpoints": [
        "https://github.com/dogukanncoskunn/KickCut/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
